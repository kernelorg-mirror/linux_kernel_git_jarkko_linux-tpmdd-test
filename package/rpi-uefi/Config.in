config BR2_PACKAGE_RPI_UEFI
	bool "rpi-uefi"
	depends on BR2_aarch64
	help
	  Prebuilt Raspberry Pi UEFI firmware images from pftf (EDK2).

	  Installs RPi3 and RPi4/400 firmware sets under
	  images/rpi-uefi/ for SD-card packaging (RPI_EFI.fd, GPU
	  firmware, config.txt).

	  https://github.com/pftf/RPi3
	  https://github.com/pftf/RPi4
