config BR2_PACKAGE_TPM2SH
	bool "tpm2sh"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_HOST_RUSTC
	select BR2_PACKAGE_HOST_PKGCONF
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_OPENSSL_FORCE_LIBOPENSSL
	help
	  TPM 2.0 command-line interface.

	  tpm2sh is a command-line interface for interacting with TPM
	  2.0 chips directly through /dev/tpm0 or /dev/tpmrm0.

	  https://github.com/jarkkojs/tpm2-library

comment "tpm2sh needs a toolchain with Rust support"
	depends on !BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
