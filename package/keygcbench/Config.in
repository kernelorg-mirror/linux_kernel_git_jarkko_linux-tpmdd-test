config BR2_PACKAGE_KEYGCBENCH
	bool "keygcbench"
	depends on BR2_LINUX_KERNEL
	depends on BR2_TOOLCHAIN_HAS_SYNC_4 # libbpf
	depends on BR2_TOOLCHAIN_HAS_THREADS # libbpf
	depends on BR2_TOOLCHAIN_HEADERS_AT_LEAST_4_13 # libbpf
	depends on !BR2_STATIC_LIBS # libbpf
	depends on BR2_USE_MMU
	depends on BR2_USE_WCHAR # libbpf
	select BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF
	select BR2_LINUX_KERNEL_NEEDS_HOST_PAHOLE
	select BR2_PACKAGE_HOST_PKGCONF
	select BR2_PACKAGE_LIBBPF
	select BR2_PACKAGE_OPENSSL
	help
	  Benchmark key garbage collection latency and competing bound
	  workqueue latency using an eBPF probe.

comment "keygcbench needs a Linux kernel and a toolchain w/ wchar, dynamic library, threads, headers >= 4.13"
	depends on BR2_USE_MMU
	depends on BR2_TOOLCHAIN_HAS_SYNC_4
	depends on !BR2_LINUX_KERNEL || !BR2_USE_WCHAR || BR2_STATIC_LIBS \
		|| !BR2_TOOLCHAIN_HAS_THREADS \
		|| !BR2_TOOLCHAIN_HEADERS_AT_LEAST_4_13
