################################################################################
#
# keygcbench
#
################################################################################

KEYGCBENCH_VERSION = 1.0
KEYGCBENCH_SITE = $(KEYGCBENCH_PKGDIR)/files
KEYGCBENCH_SITE_METHOD = local
KEYGCBENCH_LICENSE = GPL-2.0-or-later
KEYGCBENCH_DEPENDENCIES = \
	host-bpftool \
	host-pkgconf \
	libbpf \
	$(if $(BR2_LINUX_KERNEL),linux) \
	openssl

KEYGCBENCH_VMLINUX ?= $(LINUX_DIR)/vmlinux
KEYGCBENCH_BPF_TARGET = $(if $(filter BIG,$(call qstrip,$(BR2_ENDIAN))),bpfeb,bpfel)
KEYGCBENCH_MAKE_OPTS = \
	CC="$(TARGET_CC)" \
	CFLAGS="$(TARGET_CFLAGS)" \
	LDFLAGS="$(TARGET_LDFLAGS)" \
	PKG_CONFIG="$(PKG_CONFIG_HOST_BINARY)" \
	BPFTOOL="$(HOST_DIR)/sbin/bpftool" \
	BPF_TARGET="$(KEYGCBENCH_BPF_TARGET)" \
	VMLINUX_BTF="$(KEYGCBENCH_VMLINUX)"

define KEYGCBENCH_LINUX_CONFIG_FIXUPS
	$(call KCONFIG_ENABLE_OPT,CONFIG_BPF)
	$(call KCONFIG_ENABLE_OPT,CONFIG_BPF_SYSCALL)
	$(call KCONFIG_ENABLE_OPT,CONFIG_BPF_JIT)
	$(call KCONFIG_ENABLE_OPT,CONFIG_BPF_EVENTS)
	$(call KCONFIG_DISABLE_OPT,CONFIG_DEBUG_INFO_NONE)
	$(call KCONFIG_ENABLE_OPT,CONFIG_DEBUG_INFO_DWARF5)
	$(call KCONFIG_ENABLE_OPT,CONFIG_DEBUG_INFO_BTF)
	$(call KCONFIG_ENABLE_OPT,CONFIG_PERF_EVENTS)
	$(call KCONFIG_ENABLE_OPT,CONFIG_FTRACE)
	$(call KCONFIG_ENABLE_OPT,CONFIG_KPROBES)
	$(call KCONFIG_ENABLE_OPT,CONFIG_KPROBE_EVENTS)
	$(call KCONFIG_ENABLE_OPT,CONFIG_PROC_FS)
	$(call KCONFIG_ENABLE_OPT,CONFIG_KEYS)
endef

define KEYGCBENCH_BUILD_CMDS
	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) $(KEYGCBENCH_MAKE_OPTS)
endef

define KEYGCBENCH_INSTALL_TARGET_CMDS
	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) $(KEYGCBENCH_MAKE_OPTS) \
		INSTALL="$(INSTALL)" DESTDIR="$(TARGET_DIR)" PREFIX=/usr install
endef

$(eval $(generic-package))
