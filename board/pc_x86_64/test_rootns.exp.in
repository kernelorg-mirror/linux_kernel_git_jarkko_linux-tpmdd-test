#!/usr/bin/expect -f
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2024-2026 Jarkko Sakkinen <jarkko@kernel.org>

set timeout -1
spawn socat - UNIX-CONNECT:serial.sock
expect "login: "
send "root\n"
expect "# "
send "/usr/lib/kselftests/run_kselftest.sh -t rootns:smoke\n"
expect "ok 1 selftests: rootns: smoke"
expect "# "
sleep 2
