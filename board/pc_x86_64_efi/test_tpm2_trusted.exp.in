#!/usr/bin/expect -f
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2024-2026 Jarkko Sakkinen <jarkko@kernel.org>

set timeout -1
spawn socat - UNIX-CONNECT:serial.sock
send "tpm2sh create-primary rsa-2048:sha256\n"
expect -re {([0-9A-Fa-f]{8})}
set handle $expect_out(1,string)
expect "# "
sleep 2
send "tpm2sh evict $handle 81000001\n"
expect "# "
sleep 2
send "keyctl add trusted kmk 'new 32 keyhandle=0x81000001' @u\n"
expect "# "
sleep 2
send "keyctl add encrypted 1000100010001000 'new ecryptfs trusted:kmk 64' @u\n"
expect "# "
sleep 2
send "keyctl list @u\n"
expect "2 keys in keyring:"
expect "# "
sleep 2
send "tpm2sh delete '*'\n"
expect "# "
sleep 2
