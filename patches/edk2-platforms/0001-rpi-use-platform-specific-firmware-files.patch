From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jarkko Sakkinen <jarkko@kernel.org>
Date: Tue, 11 Aug 2026 03:06:42 +0300
Subject: [PATCH] rpi: use platform-specific firmware files

Use device-tree mode by default so firmware overlays are visible to the
operating system. Give each platform a distinct firmware filename so
variable writes update the FD selected by config.txt.

Drop LogoDxe so the build only needs the non-OSI TF-A binaries.
Upstream: N/A, project-specific firmware layout

Signed-off-by: Jarkko Sakkinen <jarkko@kernel.org>
---
 .../Drivers/VarBlockServiceDxe/VarBlockService.c  | 11 +++++++----
 Platform/RaspberryPi/RPi3/RPi3.dsc                |  7 +++----
 Platform/RaspberryPi/RPi3/RPi3.fdf                |  5 -----
 Platform/RaspberryPi/RPi4/RPi4.dsc                |  7 +++----
 Platform/RaspberryPi/RPi4/RPi4.fdf                |  5 -----
 5 files changed, 13 insertions(+), 22 deletions(-)

diff --git a/Platform/RaspberryPi/Drivers/VarBlockServiceDxe/VarBlockService.c b/Platform/RaspberryPi/Drivers/VarBlockServiceDxe/VarBlockService.c
index 5723094..b69461c 100644
--- a/Platform/RaspberryPi/Drivers/VarBlockServiceDxe/VarBlockService.c
+++ b/Platform/RaspberryPi/Drivers/VarBlockServiceDxe/VarBlockService.c
@@ -843,10 +843,13 @@ FvbInitialize (
   mFvInstance->FvBase = (UINTN)BaseAddress;
   mFvInstance->FvLength = (UINTN)Length;
   mFvInstance->Offset = StartOffset;
-  /*
-   * Should I parse config.txt instead and find the real name?
-   */
-  mFvInstance->MappedFile = L"RPI_EFI.FD";
+#if (RPI_MODEL == 3)
+  mFvInstance->MappedFile = L"RPI3_EFI.FD";
+#elif (RPI_MODEL == 4)
+  mFvInstance->MappedFile = L"RPI4_EFI.FD";
+#else
+#error Unsupported Raspberry Pi model
+#endif
 
   Status = ValidateFvHeader (mFvInstance->VolumeHeader);
   if (!EFI_ERROR (Status)) {
diff --git a/Platform/RaspberryPi/RPi3/RPi3.dsc b/Platform/RaspberryPi/RPi3/RPi3.dsc
index e65124d..c940c87 100644
--- a/Platform/RaspberryPi/RPi3/RPi3.dsc
+++ b/Platform/RaspberryPi/RPi3/RPi3.dsc
@@ -487,10 +487,10 @@
   # Device Tree and ACPI selection.
   #
   # 0 - SYSTEM_TABLE_MODE_ACPI
-  # 1 - SYSTEM_TABLE_MODE_BOTH (default)
-  # 2 - SYSTEM_TABLE_MODE_DT
+  # 1 - SYSTEM_TABLE_MODE_BOTH
+  # 2 - SYSTEM_TABLE_MODE_DT (default)
   #
-  gRaspberryPiTokenSpaceGuid.PcdSystemTableMode|L"SystemTableMode"|gConfigDxeFormSetGuid|0x0|1
+  gRaspberryPiTokenSpaceGuid.PcdSystemTableMode|L"SystemTableMode"|gConfigDxeFormSetGuid|0x0|2
 
   #
   # Enable a fan in the ACPI thermal zone on GPIO pin #
@@ -674,7 +674,6 @@
   MdeModulePkg/Universal/SetupBrowserDxe/SetupBrowserDxe.inf
   MdeModulePkg/Universal/DriverHealthManagerDxe/DriverHealthManagerDxe.inf
   MdeModulePkg/Universal/BdsDxe/BdsDxe.inf
-  Platform/RaspberryPi/Drivers/LogoDxe/LogoDxe.inf
   MdeModulePkg/Application/UiApp/UiApp.inf {
     <LibraryClasses>
       NULL|MdeModulePkg/Library/DeviceManagerUiLib/DeviceManagerUiLib.inf
diff --git a/Platform/RaspberryPi/RPi3/RPi3.fdf b/Platform/RaspberryPi/RPi3/RPi3.fdf
index 9a681a5..15ce24a 100644
--- a/Platform/RaspberryPi/RPi3/RPi3.fdf
+++ b/Platform/RaspberryPi/RPi3/RPi3.fdf
@@ -299,11 +299,6 @@ READ_LOCK_STATUS   = TRUE
   INF Platform/RaspberryPi/Drivers/ArasanMmcHostDxe/ArasanMmcHostDxe.inf
   INF Platform/RaspberryPi/Drivers/MmcDxe/MmcDxe.inf
 
-  #
-  # Pi logo (splash screen)
-  #
-  INF Platform/RaspberryPi/Drivers/LogoDxe/LogoDxe.inf
-
 [FV.FVMAIN_COMPACT]
 FvAlignment        = 16
 ERASE_POLARITY     = 1
diff --git a/Platform/RaspberryPi/RPi4/RPi4.dsc b/Platform/RaspberryPi/RPi4/RPi4.dsc
index 8adaf93..4c955a8 100644
--- a/Platform/RaspberryPi/RPi4/RPi4.dsc
+++ b/Platform/RaspberryPi/RPi4/RPi4.dsc
@@ -502,11 +502,11 @@
   #
   # Device Tree and ACPI selection.
   #
-  # 0 - SYSTEM_TABLE_MODE_ACPI (default)
+  # 0 - SYSTEM_TABLE_MODE_ACPI
   # 1 - SYSTEM_TABLE_MODE_BOTH
-  # 2 - SYSTEM_TABLE_MODE_DT
+  # 2 - SYSTEM_TABLE_MODE_DT (default)
   #
-  gRaspberryPiTokenSpaceGuid.PcdSystemTableMode|L"SystemTableMode"|gConfigDxeFormSetGuid|0x0|0
+  gRaspberryPiTokenSpaceGuid.PcdSystemTableMode|L"SystemTableMode"|gConfigDxeFormSetGuid|0x0|2
 
   #
   # Enable a fan in the ACPI thermal zone on GPIO pin #
@@ -700,7 +700,6 @@
   MdeModulePkg/Universal/SetupBrowserDxe/SetupBrowserDxe.inf
   MdeModulePkg/Universal/DriverHealthManagerDxe/DriverHealthManagerDxe.inf
   MdeModulePkg/Universal/BdsDxe/BdsDxe.inf
-  Platform/RaspberryPi/Drivers/LogoDxe/LogoDxe.inf
   MdeModulePkg/Application/UiApp/UiApp.inf {
     <LibraryClasses>
       NULL|MdeModulePkg/Library/BootDiscoveryPolicyUiLib/BootDiscoveryPolicyUiLib.inf
diff --git a/Platform/RaspberryPi/RPi4/RPi4.fdf b/Platform/RaspberryPi/RPi4/RPi4.fdf
index ba13c79..a13fcba 100644
--- a/Platform/RaspberryPi/RPi4/RPi4.fdf
+++ b/Platform/RaspberryPi/RPi4/RPi4.fdf
@@ -315,11 +315,6 @@ READ_LOCK_STATUS   = TRUE
   INF Platform/RaspberryPi/Drivers/ArasanMmcHostDxe/ArasanMmcHostDxe.inf
   INF Platform/RaspberryPi/Drivers/MmcDxe/MmcDxe.inf
 
-  #
-  # Pi logo (splash screen)
-  #
-  INF Platform/RaspberryPi/Drivers/LogoDxe/LogoDxe.inf
-
 [FV.FVMAIN_COMPACT]
 FvAlignment        = 16
 ERASE_POLARITY     = 1
-- 
2.51.0
