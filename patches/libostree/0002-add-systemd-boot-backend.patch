diff --git a/src/libostree/ostree-impl-system-generator.c b/src/libostree/ostree-impl-system-generator.c
index a21ff6b..dbad825 100644
--- a/src/libostree/ostree-impl-system-generator.c
+++ b/src/libostree/ostree-impl-system-generator.c
@@ -150,6 +150,37 @@ _ostree_sysroot_parse_bootlink_aboot (const char *bootlink, char **out_osname, G
   return TRUE;
 }
 
+static gboolean
+parse_systemd_boot_stateroot (const char *bootlink, char **out_stateroot, GError **error)
+{
+  g_autofree char *symlink_path = g_strconcat ("/sysroot", bootlink, NULL);
+  g_autofree char *symlink_val = glnx_readlinkat_malloc (AT_FDCWD, symlink_path, NULL, error);
+  if (!symlink_val)
+    return glnx_prefix_error (error, "Reading systemd-boot deployment symlink %s", symlink_path);
+
+  static gsize regex_initialized;
+  static GRegex *regex;
+  if (g_once_init_enter (&regex_initialized))
+    {
+      regex = g_regex_new ("\\A\\.\\./deploy/([A-Za-z0-9_.-]+)/deploy/[0-9a-f]{64}\\.[0-9]+\\z",
+                           0, 0, NULL);
+      g_assert (regex);
+      g_once_init_leave (&regex_initialized, 1);
+    }
+
+  g_autoptr (GMatchInfo) match = NULL;
