       </varlistentry>
diff --git a/src/libostree/ostree-bootloader-systemd-boot.c b/src/libostree/ostree-bootloader-systemd-boot.c
new file mode 100644
index 0000000..e8dae00
--- /dev/null
+++ b/src/libostree/ostree-bootloader-systemd-boot.c
@@ -0,0 +1,141 @@
+/* SPDX-License-Identifier: LGPL-2.0-or-later */
+
+#include "config.h"
+
+#include "ostree-bootloader-systemd-boot.h"
+#include "ostree-repo-private.h"
+
+struct _OstreeBootloaderSystemdBoot
+{
+  GObject parent_instance;
+
+  OstreeSysroot *sysroot;
+};
+
+typedef GObjectClass OstreeBootloaderSystemdBootClass;
+
+static void _ostree_bootloader_systemd_boot_bootloader_iface_init (OstreeBootloaderInterface *iface);
+G_DEFINE_TYPE_WITH_CODE (
+    OstreeBootloaderSystemdBoot, _ostree_bootloader_systemd_boot, G_TYPE_OBJECT,
+    G_IMPLEMENT_INTERFACE (OSTREE_TYPE_BOOTLOADER,
+                           _ostree_bootloader_systemd_boot_bootloader_iface_init));
+
+static gboolean
+_ostree_bootloader_systemd_boot_query (OstreeBootloader *bootloader, gboolean *out_is_active,
+                                       GCancellable *cancellable, GError **error)
+{
+  *out_is_active = FALSE;
+  return TRUE;
+}
+
+static const char *
+_ostree_bootloader_systemd_boot_get_name (OstreeBootloader *bootloader)
+{
+  return "systemd-boot";
+}
+
+static gboolean
+run_helper (OstreeSysroot *sysroot, const char *phase, int bootversion, GCancellable *cancellable,
+            GError **error)
+{
+  const char *sysroot_path = gs_file_get_path_cached (ostree_sysroot_get_path (sysroot));
+  g_autofree char *bootversion_str = g_strdup_printf ("%d", bootversion);
+  const char *argv[] = { TARGET_PREFIX "/lib/ostree/ostree-systemd-boot", phase, sysroot_path,
+                         bootversion_str, NULL };
+  g_autofree char *stdout_buf = NULL;
+  g_autofree char *stderr_buf = NULL;
+  int status;
+
+  if (g_cancellable_set_error_if_cancelled (cancellable, error))
+    return FALSE;
+
+  if (!g_spawn_sync (NULL, (char **)argv, NULL, 0, NULL, NULL, &stdout_buf, &stderr_buf, &status,
+                     error))
+    return glnx_prefix_error (error, "Running %s %s %s %s", argv[0], phase, sysroot_path,
+                              bootversion_str);
+
+  if (!g_spawn_check_wait_status (status, error))
+    return glnx_prefix_error (error, "%s %s %s %s (stdout: %s; stderr: %s)", argv[0], phase,
+                              sysroot_path, bootversion_str, stdout_buf, stderr_buf);
+
+  if (*stdout_buf)
+    g_print ("%s", stdout_buf);
+  if (*stderr_buf)
+    g_printerr ("%s", stderr_buf);
+
+  return TRUE;
+}
+
+gboolean
+_ostree_bootloader_systemd_boot_recover (OstreeSysroot *sysroot, GCancellable *cancellable,
+                                       GError **error)
+{
+  if (ostree_sysroot_repo (sysroot)->bootloader != CFG_SYSROOT_BOOTLOADER_OPT_SYSTEMD_BOOT)
+    return TRUE;
+
+  return run_helper (sysroot, "recover", 0, cancellable, error);
+}
+
+static gboolean
+_ostree_bootloader_systemd_boot_write_config (OstreeBootloader *bootloader, int bootversion,
+                                              GPtrArray *new_deployments, GCancellable *cancellable,
+                                              GError **error)
+{
+  OstreeBootloaderSystemdBoot *self = OSTREE_BOOTLOADER_SYSTEMD_BOOT (bootloader);
+  return run_helper (self->sysroot, "prepare", bootversion, cancellable, error);
+}
+
+static gboolean
+_ostree_bootloader_systemd_boot_post_bls_sync (OstreeBootloader *bootloader, int bootversion,
+                                               GCancellable *cancellable, GError **error)
+{
+  OstreeBootloaderSystemdBoot *self = OSTREE_BOOTLOADER_SYSTEMD_BOOT (bootloader);
+  return run_helper (self->sysroot, "commit", bootversion, cancellable, error);
+}
+
+static gboolean
+_ostree_bootloader_systemd_boot_is_atomic (OstreeBootloader *bootloader)
+{
+  return FALSE;
+}
+
+static void
+_ostree_bootloader_systemd_boot_finalize (GObject *object)
+{
+  OstreeBootloaderSystemdBoot *self = OSTREE_BOOTLOADER_SYSTEMD_BOOT (object);
+
+  g_clear_object (&self->sysroot);
+
+  G_OBJECT_CLASS (_ostree_bootloader_systemd_boot_parent_class)->finalize (object);
+}
+
+static void
+_ostree_bootloader_systemd_boot_init (OstreeBootloaderSystemdBoot *self)
+{
+}
+
+static void
+_ostree_bootloader_systemd_boot_bootloader_iface_init (OstreeBootloaderInterface *iface)
+{
+  iface->query = _ostree_bootloader_systemd_boot_query;
+  iface->get_name = _ostree_bootloader_systemd_boot_get_name;
+  iface->write_config = _ostree_bootloader_systemd_boot_write_config;
+  iface->post_bls_sync = _ostree_bootloader_systemd_boot_post_bls_sync;
+  iface->is_atomic = _ostree_bootloader_systemd_boot_is_atomic;
+}
+
+static void
+_ostree_bootloader_systemd_boot_class_init (OstreeBootloaderSystemdBootClass *class)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (class);
+
+  object_class->finalize = _ostree_bootloader_systemd_boot_finalize;
+}
+
+OstreeBootloaderSystemdBoot *
+_ostree_bootloader_systemd_boot_new (OstreeSysroot *sysroot)
+{
+  OstreeBootloaderSystemdBoot *self = g_object_new (OSTREE_TYPE_BOOTLOADER_SYSTEMD_BOOT, NULL);
+  self->sysroot = g_object_ref (sysroot);
+  return self;
+}
