 # Generates OCI image config.
 # MediaType: application/vnd.oci.image.config.v1+json
 #
+# Empty config keys are omitted so bootc/skopeo do not see blank
+# Entrypoint/Env/Ports/Volumes objects.
+#
 # $1: DiffID of the rootfs (i.e. digest of uncompressed TAR archive)
 oci_image_config() {
 	local rootfs_diff_id="$1"
-	local created=$(time_now)
+	local created fields
 
-	cat <<-EOF
-	{
-	  "created": "$created",
-	  "author": $(json_string "$CFG_AUTHOR" null),
-	  "architecture": "$(oci_arch $CFG_ARCH)",
-	  "os": "$CFG_OS",
-	  "config": {
-	    ${CFG_USER:+"$(echo \"User\"): $(json_string "$CFG_USER"),"}
-	    "ExposedPorts": $(json_pseudoarray "$CFG_PORTS"),
-	    "Env": $(json_string_array "$CFG_ENV"),
-	    "Entrypoint": $(json_string_array "$CFG_ENTRYPOINT"),
-	    "Cmd": $(json_string_array "$CFG_CMD"),
-	    "Volumes": $(json_pseudoarray "$CFG_VOLUMES"),
-	    ${CFG_WORKING_DIR:+"$(echo \"WorkingDir\"): $(json_string "$CFG_WORKING_DIR"),"}
-	    "Labels": $(json_string_map "$CFG_LABELS")
-	  },
-	  "rootfs": {
-	    "diff_ids": [ "$rootfs_diff_id" ],
-	    "type": "layers"
-	  },
-	  "history": [
-	    {
-	      "created": "$created",
-	      "created_by": $(json_string "$CFG_AUTHOR")
-	    }
-	  ]
-	}
-	EOF
+	created=$(time_now)
+	fields=""
+	[ -n "$CFG_USER" ] && fields=$(json_add_field "$fields" "\"User\": $(json_string "$CFG_USER")")
+	[ -n "$CFG_PORTS" ] && fields=$(json_add_field "$fields" "\"ExposedPorts\": $(json_pseudoarray "$CFG_PORTS")")
+	[ -n "$CFG_ENV" ] && fields=$(json_add_field "$fields" "\"Env\": $(json_string_array "$CFG_ENV")")
+	[ -n "$CFG_ENTRYPOINT" ] && fields=$(json_add_field "$fields" "\"Entrypoint\": $(json_string_array "$CFG_ENTRYPOINT")")
+	[ -n "$CFG_CMD" ] && fields=$(json_add_field "$fields" "\"Cmd\": $(json_string_array "$CFG_CMD")")
+	[ -n "$CFG_VOLUMES" ] && fields=$(json_add_field "$fields" "\"Volumes\": $(json_pseudoarray "$CFG_VOLUMES")")
+	[ -n "$CFG_WORKING_DIR" ] && fields=$(json_add_field "$fields" "\"WorkingDir\": $(json_string "$CFG_WORKING_DIR")")
+	[ -n "$CFG_LABELS" ] && fields=$(json_add_field "$fields" "\"Labels\": $(json_string_map "$CFG_LABELS")")
+
+	printf '{\n'
+	printf '  "created": "%s",\n' "$created"
+	if [ -n "$CFG_AUTHOR" ]; then
+		printf '  "author": %s,\n' "$(json_string "$CFG_AUTHOR")"
+	fi
+	printf '  "architecture": "%s",\n' "$(oci_arch $CFG_ARCH)"
+	printf '  "os": "%s",\n' "$CFG_OS"
+	printf '  "config": {\n'
+	if [ -n "$fields" ]; then
+		printf '    %s\n' "$fields"
+	fi
+	printf '  },\n'
+	printf '  "rootfs": {\n'
+	printf '    "diff_ids": [ "%s" ],\n' "$rootfs_diff_id"
+	printf '    "type": "layers"\n'
+	printf '  },\n'
+	printf '  "history": [\n'
+	printf '    {\n'
+	printf '      "created": "%s",\n' "$created"
+	printf '      "created_by": %s\n' "$(json_string "${CFG_AUTHOR:-tpmdd-oci}")"
+	printf '    }\n'
+	printf '  ]\n'
+	printf '}\n'
 }
 
