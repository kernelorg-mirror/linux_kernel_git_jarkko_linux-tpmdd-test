diff --git a/support/download/cargo-post-process b/support/download/cargo-post-process
index b0e59ad..b2af511 100755
--- a/support/download/cargo-post-process
+++ b/support/download/cargo-post-process
@@ -28,16 +28,18 @@ fi
 
 post_process_unpack "${base_name}" "${output}"
 
-# Do the Cargo vendoring
+# Vendor with cargo run from / (avoid hierarchical ~/.cargo configs).
 pushd "${base_name}" > /dev/null
+pkg_dir=$(pwd)
 
 # Create the local .cargo/config.toml with vendor info
 mkdir -p .cargo/
 mkdir -p "${CARGO_HOME}"
 flock "${CARGO_HOME}"/.br-lock \
-cargo vendor \
-    --manifest-path "${manifest}" \
-    --locked VENDOR \
+env -C / cargo vendor \
+    --manifest-path "${pkg_dir}/${manifest}" \
+    --locked "${pkg_dir}/VENDOR" \
+    | sed 's|^directory = ".*"|directory = "VENDOR"|' \
     > .cargo/config.toml
 
